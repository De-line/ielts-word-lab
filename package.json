{
  "name": "ielts-word-lab",
  "private": true,
  "packageManager": "pnpm@8.6.10",
  "scripts": {
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4176 --strictPort",
    "test:release": "node test/browser/release.browser.mjs",
    "check:release": "node scripts/check-release.mjs",
    "lint:target": "eslint build/*.ts scripts/*.mjs vite.config.ts src/lib/vocabulary src/pages/vocabulary/typing.vue src/pages/vocabulary/records.vue test/vocabulary test/browser/*.mjs .github/workflows/*.yml",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:browser": "node test/browser/typing.browser.mjs",
    "up": "taze major -I"
  },
  "dependencies": {
    "@vueuse/core": "^10.1.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.5",
    "@iconify-json/carbon": "^1.1.17",
    "@iconify-json/ph": "^1.1.12",
    "@iconify-json/simple-icons": "^1.1.87",
    "@types/node": "^20.2.5",
    "@unocss/eslint-config": "^0.53.0",
    "@unocss/reset": "^0.53.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue-macros/volar": "^0.10.2",
    "@vue/test-utils": "^2.3.2",
    "eslint": "^8.42.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^13.2.2",
    "playwright-core": "1.62.1",
    "pnpm": "^8.6.0",
    "taze": "^0.10.2",
    "typescript": "^5.1.3",
    "unocss": "^0.53.0",
    "unplugin-auto-import": "^0.16.4",
    "unplugin-vue-components": "^0.25.0",
    "unplugin-vue-macros": "^2.2.1",
    "vite": "^4.3.9",
    "vite-plugin-pages": "^0.31.0",
    "vitest": "^0.31.4",
    "vue-tsc": "^1.6.5"
  },
  "eslintConfig": {
    "extends": [
      "@antfu",
      "@unocss"
    ]
  }
}
